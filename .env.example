# ─────────────────────────────────────────────────────────────
# REQUIRED — Neon connection string
# Get one free at neon.tech (create a project → Connection Details),
# or on Vercel: Storage → Create Database → Neon.
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ─────────────────────────────────────────────────────────────
# OPTIONAL — real LLM scoring via Gemini.
# Get a key at https://aistudio.google.com/apikey
# Leave unset (or blank) and the app silently uses the built-in
# deterministic rubric in lib/score.ts. Never required.
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=""

# OPTIONAL — override the Gemini model (default: gemini-3.7-flash).
# gemini-3.5-flash-lite is cheaper and faster for high volume.
GEMINI_MODEL=""

# ─────────────────────────────────────────────────────────────
# OPTIONAL — fire the automation layer on every new lead.
# When set, POST /api/leads fire-and-forgets the lead JSON to this
# URL (your n8n / Make / Zapier webhook). Unset = fully standalone.
# ─────────────────────────────────────────────────────────────
N8N_WEBHOOK_URL=""
